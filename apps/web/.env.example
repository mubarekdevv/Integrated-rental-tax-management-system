# PostgreSQL connection string.
# Local dev without Docker/root Postgres: run `npx prisma dev` and paste the
# printed TCP connection string here. With Docker: `docker compose up -d`
# in the repo root, then use postgres://postgres:postgres@localhost:5432/rental_tax
DATABASE_URL="postgres://postgres:postgres@localhost:5432/rental_tax"

# Auth.js / NextAuth secret used to sign session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
# Trust the request Host header for Auth.js's CSRF/origin check. Needed when
# running behind a proxy or on a port other than NEXTAUTH_URL during a demo.
AUTH_TRUST_HOST=true

NEXT_PUBLIC_APP_URL="http://localhost:3000"
